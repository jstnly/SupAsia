# Supabase — create a free project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Google Cloud TTS — https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=YOUR-GOOGLE-TTS-KEY

# Optional: Whisper STT fallback via Groq — https://console.groq.com/keys
GROQ_API_KEY=YOUR-GROQ-KEY

# Optional: Cloudflare R2 audio cache — https://developers.cloudflare.com/r2/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=biet-tieng-viet-audio
R2_PUBLIC_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
